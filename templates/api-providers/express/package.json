    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "find-config": "^1.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/find-config": "^1.0.4",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "ts-add-js-extension": "^1.6.6",
    "tsx": "^4.23.1",
